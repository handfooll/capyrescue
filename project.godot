; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Meowdoku"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://ui/main_menu.tscn"

[autoload]

Settings="*res://autoload/settings_manager.gd"
GameData="*res://autoload/game_data.gd"
Audio="*res://autoload/audio_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/godotx_safe_area/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"
